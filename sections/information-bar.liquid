{% comment %}
  sections/scrolling-info-bar.liquid
{% endcomment %}

{%- style -%}
  .scrolling-info-bar {
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
    width: 100%;
    position: relative;
    padding: 12px 0;
  }

  .scrolling-info-bar__content {
    display: flex;
    white-space: nowrap;
    gap: 60px;
    width: max-content;
    position: relative;
  }

  .scrolling-info-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.font_size }}px;
  }

  .scrolling-info-bar__heading {
    margin: 0;
    text-decoration: none;
    color: {{ section.settings.text_color }};
  }

  .scrolling-info-bar__icon {
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    fill: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .scrolling-info-bar {
      {% unless section.settings.show_on_mobile %}display: none;{% endunless %}
    }
    
    .scrolling-info-bar__content {
      gap: 40px;
    }
  }

  @keyframes scrollText {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
{%- endstyle -%}

<div class="scrolling-info-bar">
  <div class="scrolling-info-bar__content" id="scrolling-content-{{ section.id }}">
    {%- capture info_content -%}
      {% for block in section.blocks %}
        {% if block.type == 'text_column' %}
          <div class="scrolling-info-bar__item" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link }}" class="scrolling-info-bar__heading">
              {{ block.settings.heading }}
            </a>
            {% if block.settings.icon != 'none' %}
              <div class="scrolling-info-bar__icon">
                {% render 'icon-info-bar', icon: block.settings.icon %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {%- endcapture -%}
    {{ info_content }}
    {{ info_content }}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const content = document.getElementById('scrolling-content-{{ section.id }}');
    if (!content) return;

    function initScroll() {
      // Remove any existing animation
      content.style.animation = 'none';
      content.offsetHeight; // Trigger reflow
      
      // Clone content for seamless loop if not already cloned
      if (!content.dataset.initialized) {
        const originalContent = content.innerHTML;
        content.innerHTML = originalContent + originalContent;
        content.dataset.initialized = 'true';
      }
      
      // Apply new animation
      const duration = window.innerWidth <= 749 ? 
        {{ section.settings.mobile_scroll_speed }} : 
        {{ section.settings.desktop_scroll_speed }};
      
      content.style.animation = `scrollText ${duration}s linear infinite`;
    }

    // Initialize scroll
    initScroll();
    
    // Handle window resize for mobile/desktop speed changes
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(initScroll, 250);
    });
    
    // Pause on hover
    content.addEventListener('mouseenter', () => {
      content.style.animationPlayState = 'paused';
    });
    
    content.addEventListener('mouseleave', () => {
      content.style.animationPlayState = 'running';
    });
  });
</script>

{% schema %}
{
  "name": "Scrolling Info Bar",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desktop_scroll_speed",
      "label": "Desktop scroll speed (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_scroll_speed",
      "label": "Mobile scroll speed (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "text_column",
      "name": "Text Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Announcement text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "circle",
              "label": "Circle"
            },
            {
              "value": "diamond",
              "label": "Diamond"
            },
            {
              "value": "arrow",
              "label": "Arrow"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling Info Bar",
      "blocks": [
        {
          "type": "text_column"
        }
      ]
    }
  ]
}
{% endschema %}