{% schema %}
{
  "name": "Multi Grid Section",
  "tag": "section",
  "class": "grid-section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Grid Gallery"
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section Padding",
      "options": [
        {
          "value": "padding-sm",
          "label": "Small"
        },
        {
          "value": "padding-md",
          "label": "Medium"
        },
        {
          "value": "padding-lg",
          "label": "Large"
        }
      ],
      "default": "padding-md"
    },
    {
        "type": "checkbox",
        "id": "animations_reveal_on_scroll",
        "label": "Enable Scroll-Reveal Animation",
        "default": true
      }
  ],
  "blocks": [
    {
