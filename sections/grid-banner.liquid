<style>
    .grid-section {
        padding: var(--section-padding, 60px 20px);
      }
      
      .grid-section .padding-sm {
        --section-padding: 30px 20px;
      }
      
      .grid-section .padding-md {
        --section-padding: 60px 20px;
      }
      
      .grid-section .padding-lg {
        --section-padding: 90px 20px;
      }
      
      .grid-container {
        max-width: 1800px;
        margin: 0 auto;
        padding: 0 20px;
        overflow: hidden;
      }
      
      .grid-heading {
        text-align: center;
        margin-bottom: 40px;
      }
      
      /* Style 1 - Two Banner Grid (930x620) */
      .grid-style-1 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin: 10px auto;
      }
      
      .grid-style-1 .banner-link {
        aspect-ratio: 930/620;
      }
      
      /* Style 2 - Three Banner Grid (640x640) */
      .grid-style-2 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 10px auto;
      }
      
      .grid-style-2 .banner-link {
        aspect-ratio: 1/1;
      }
      
      /* Style 3 - Asymmetric Grid */
      .grid-style-3 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin: 10px auto;
        overflow: hidden;
      }
      
      .grid-style-3 .left-banner {
        grid-row: span 2;
        min-width: 0; /* Prevent content from pushing container width */
      }
      
      .grid-style-3 .right-stack {
        display: grid;
        gap: 20px;
        min-width: 0; /* Prevent content from pushing container width */
      }

      .grid-style-3 .banner-link {
        min-width: 0; /* Prevent content from pushing container width */
      }
      
      /* Style 4 - Left Stack Right Banner (Adjusted) */
      .grid-style-4 {
        display: grid;
        grid-template-columns: 1fr 1.5fr; /* Adjusted ratio to match visual proportions */
        gap: 20px;
        margin: 10px auto;
      }
      
      .grid-style-4 .left-stack {
        display: grid;
        gap: 20px;
      }
      
      .grid-style-4 .left-stack .banner-link {
        aspect-ratio: 930/445; /* Adjusted to maintain proportion with other grids */
      }
      
      .grid-style-4 .right-banner .banner-link {
        aspect-ratio: 930/620; /* Matched with style_1 proportions */
      }
      
      /* Common styles */
      .banner-link {
        display: block;
        position: relative;
        width: 100%;
        height: 100%;
      }
      
      .banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      
      /* Responsive adjustments */
      @media screen and (max-width: 767px) {
        .grid-style-1,
        .grid-style-2,
        .grid-style-3,
        .grid-style-4 {
          grid-template-columns: 1fr;
        }
        
        .grid-style-3 .left-banner {
          grid-row: auto;
        }
        
        .grid-style-4 .left-stack,
        .grid-style-4 .right-banner {
          max-width: 100%;
        }
      }

      /* Style 5 - Five Grid Layout */
      .grid-style-5 {
        display: grid;
        grid-template-columns: 1fr 2fr 1fr;
        gap: 20px;
        margin: 10px auto;
        width: 100%;
        max-width: 1880px;
        overflow: hidden;
      }

      .grid-style-5 .left-stack,
      .grid-style-5 .right-stack {
        display: grid;
        gap: 20px;
        width: 100%;
        height: 100%;
        min-width: 0; /* Prevent content from pushing container width */
      }

      .grid-style-5 .banner-link {
        min-width: 0; /* Prevent content from pushing container width */
      }

      .grid-style-5 .center-banner {
        width: 100%;
        margin: 0 auto;
        aspect-ratio: 1/1;
      }

      .grid-style-5 .left-stack .banner-link,
      .grid-style-5 .right-stack .banner-link {
        aspect-ratio: 1/1;
        width: 100%;
        display: block;
      }

      .grid-style-5 .center-banner .banner-link {
        aspect-ratio: 1/1;
        width: 100%;
        display: block;
      }

      .grid-style-5 .banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      @media screen and (max-width: 767px) {
        .grid-style-5 {
          grid-template-columns: 1fr;
          gap: 20px;
        }
        
        .grid-style-5 .left-stack,
        .grid-style-5 .right-stack,
        .grid-style-5 .center-banner {
          width: 100%;
        }
        
        .grid-style-5 .left-stack .banner-link,
        .grid-style-5 .right-stack .banner-link,
        .grid-style-5 .center-banner .banner-link {
          width: 100%;
          aspect-ratio: 1/1;
        }

        .grid-style-5 .banner-image {
          width: 100%;
          height: 100%;
        }
      }

      /* Common container styles */
      .grid-style-1,
      .grid-style-2,
      .grid-style-3,
      .grid-style-4,
      .grid-style-5 {
        max-width: 1800px;
      }
</style>

